# multi user creation v2 

# Create Group Name: admingroup
if ! getent group admingroup > /dev/null; then
sudo groupadd admingroup
fi

getent group | grep admingroup
sleep 1
# Check the default configuration
sudo cat /etc/login.defs
sleep 6
sudo cat /etc/default/useradd
sleep 6

# Choose the parameters -m or -s based on the default configuration

# Create User01 and set default password
if ! id user01 > /dev/null; then
sudo useradd -G admingroup user01
echo "redhat" | sudo passwd --stdin user01
fi

# Create User02 and set default password
if ! id user02 > /dev/null; then
sudo useradd -m -s /bin/bash -G admingroup user02
echo "redhat" | sudo passwd --stdin user02
fi

# Create User03 and set default password
if ! id user03 > /dev/null; then
sudo useradd -m -s /bin/bash -G admingroup user03
echo "redhat" | sudo passwd --stdin user03
fi

# ###################################### # 

# Status (Optional)
echo "Group created : admingroup"
sleep 1
echo "Users created : user01, user02, user03"
sleep 1
echo "Users added in admingroup"
sleep 1
echo "Default password set for all users : redhat"
sleep 1
# Verify
grep "^admingroup" /etc/group
